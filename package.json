{
  "name": "receita-venancio",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @receita/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @receita/api db:migrate:deploy",
    "db:seed": "pnpm --filter @receita/api db:seed",
    "db:reset": "pnpm --filter @receita/api db:reset",
    "test:e2e:web": "pnpm build && pnpm --filter @receita/web test:e2e:web"
  },
  "devDependencies": {
    "@receita/config": "workspace:*",
    "prettier": "^3.9.9",
    "turbo": "^2.10.0",
    "typescript": "~6.0.3"
  }
}
