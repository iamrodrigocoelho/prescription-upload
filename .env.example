# =============================================================================
# Receita Venancio — variáveis de ambiente
# Copie para `.env` (nunca versionado) e ajuste. Em produção, injete pelo
# orquestrador/secret manager — nunca por arquivo no repositório.
# Gere segredos com:  openssl rand -base64 32
# =============================================================================

# --- Geral --------------------------------------------------------------------
NODE_ENV=development
# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Logs legíveis no terminal (apenas desenvolvimento)
LOG_PRETTY=true

# --- URLs ---------------------------------------------------------------------
# URL pública do frontend. Base dos links /l/{slug} e /p/{token}.
# PENDENTE: domínio definitivo (PRD §42.2).
PUBLIC_APP_URL=http://localhost:3000
# Porta da API e URL interna usada pelo Next.js para fazer proxy de /api/*
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
# `trust proxy` do Express = número de proxies confiáveis imediatamente à frente da API.
# Produção: 1, com o proxy de borda encaminhando /api direto à API e SOBRESCREVENDO
# X-Forwarded-For (infra/caddy/Caddyfile.example). A API nunca deve ficar exposta
# diretamente à internet. Em dev, o rewrite do Next repassa o X-Forwarded-For do
# cliente sem validá-lo (ver docs/decisions.md D-035).
TRUST_PROXY=1

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=receita
POSTGRES_PASSWORD=receita_dev
POSTGRES_DB=receita
DATABASE_URL=postgresql://receita:receita_dev@localhost:5432/receita
# Banco exclusivo dos testes e2e (é recriado pelos testes)
TEST_DATABASE_URL=postgresql://receita:receita_dev@localhost:5432/receita_test

# --- Valkey (compatível com Redis) — rate limiting --------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=rv:
TEST_REDIS_URL=redis://localhost:6379/1

# --- Criptografia de campos sensíveis (OBRIGATÓRIO) -------------------------
# AES-256-GCM para CPF — 32 bytes em base64
CPF_ENCRYPTION_KEY=
# Pepper do HMAC-SHA256 usado em cpf_hash_for_lookup — mínimo 32 caracteres
CPF_LOOKUP_PEPPER=
# AES-256-GCM para segredos TOTP — 32 bytes em base64 (chave distinta da do CPF)
TOTP_ENCRYPTION_KEY=
# Segredo para derivar tokens CSRF — mínimo 32 caracteres
SESSION_SECRET=

# --- Sessão -------------------------------------------------------------------
# Cookies Secure. Obrigatório `true` em produção (usa prefixo __Host-).
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Janela para concluir a verificação TOTP após a senha
MFA_PENDING_TTL_MINUTES=5

# --- Brute force --------------------------------------------------------------
# Tentativas de login por IP dentro da janela
LOGIN_RATE_LIMIT_POINTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Bloqueio progressivo por conta: após N falhas, bloqueia BASE segundos,
# dobrando a cada nova falha até MAX
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=60
LOCKOUT_MAX_SECONDS=1800

# --- Área pública (PRD §10.3) ----------------------------------------------
# Consultas de contexto (loja por slug, busca de lojas, link personalizado) por IP
PUBLIC_LOOKUP_RATE_LIMIT_POINTS=120
PUBLIC_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=60
# Envios de receita por IP. Atenção: clientes no Wi-Fi da loja compartilham o IP.
PUBLIC_SUBMIT_RATE_LIMIT_POINTS=30
PUBLIC_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=900

# --- Senha --------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TTL_MINUTES=30
# Validade do convite (definição de senha de novos usuários)
INVITE_TTL_HOURS=72

# --- E-mail (SMTP) ------------------------------------------------------------
# Desenvolvimento: Mailpit (UI em http://localhost:8025)
# PENDENTE: serviço de e-mail de produção (PRD §42.6)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Receita Venancio <nao-responda@localhost>"

# --- reCAPTCHA v2 checkbox (PRD §10) ----------------------------------------
# Desenvolvimento/testes: chaves de TESTE oficiais do Google (sempre aprovam e o
# widget exibe um aviso). PRODUÇÃO: crie as chaves em
# https://www.google.com/recaptcha/admin (tipo "v2 Checkbox") para o domínio
# definitivo e preencha RECAPTCHA_SECRET_KEY (API) e NEXT_PUBLIC_RECAPTCHA_SITE_KEY
# (web). A API recusa a chave de teste com NODE_ENV=production.
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Hostnames aceitos no siteverify. Produção: apenas o domínio definitivo.
RECAPTCHA_EXPECTED_HOSTNAMES=localhost,testkey.google.com

# --- Aviso de privacidade (PRD §22.2) --------------------------------------
# PENDENTE (Jurídico/DPO): URL da Política/Aviso de Privacidade da Venancio.
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://pendente.invalid/politica-de-privacidade

# --- Métricas (Prometheus) ---------------------------------------------------
# Token exigido em GET /metrics (Authorization: Bearer). Vazio = endpoint desligado.
# Exponha /metrics apenas na rede interna.
METRICS_TOKEN=

# --- Pacientes ----------------------------------------------------------------
# mock: pacientes fictícios (proibido em produção) | none: integração indisponível
# PENDENTE: contrato da API real (PRD §27)
PATIENT_PROVIDER=mock

# --- Object storage S3-compatible (SeaweedFS) -------------------------------
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=receitas
STORAGE_ACCESS_KEY=receita
STORAGE_SECRET_KEY=receita_dev_secret
STORAGE_FORCE_PATH_STYLE=true
# Validade das URLs assinadas (segundos)
SIGNED_URL_TTL_SECONDS=60

# --- Seed de desenvolvimento -------------------------------------------------
SEED_ADMIN_NAME="Administrador Dev"
SEED_ADMIN_EMAIL=admin@receita.local
SEED_ADMIN_PASSWORD=
# Exigir 2FA do admin semeado (recomendado `true` fora do desenvolvimento local)
SEED_ADMIN_TOTP_REQUIRED=false
# Senha dos usuários de exemplo (gestor/colaborador)
SEED_DEMO_PASSWORD=
