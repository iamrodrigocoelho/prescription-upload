{
  "extends": "@receita/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    "e2e",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
