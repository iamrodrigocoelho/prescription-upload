{
  "name": "@receita/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "worker": "node dist/worker.js",
    "dev:worker": "node --enable-source-maps --watch-path=dist dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/lib-storage": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@receita/shared": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.10",
    "busboy": "^1.6.0",
    "cockatiel": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "file-type": "^22.1.1",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@receita/config": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
