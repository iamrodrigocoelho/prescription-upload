# Proxy de borda para produção self-hosted (Caddy 2, Apache-2.0).
# - TLS automático (ou certificados próprios);
# - /api/* vai DIRETO para a API (não passa pelo Next);
# - X-Forwarded-For é SOBRESCRITO com o IP real do cliente: um valor enviado pelo
#   cliente nunca chega à API (base do rate limit por IP). Com esta topologia, use
#   TRUST_PROXY=1 na API e não exponha as portas da API/web fora da rede interna.
# Domínio definitivo pendente (PRD §42.2).

receita.example.com {
	encode zstd gzip

	# Log de acesso sem credenciais: o token do link personalizado (/p/{token} e
	# /api/public/patient-links/{token}) e query strings são mascarados (PRD §6.5).
	log {
		output file /var/log/caddy/receita-access.log
		format filter {
			request>uri regexp "^(/p/|/api/public/patient-links/)[^/?]+" "${1}[REDACTED]"
			request>uri query delete *
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Referer delete
		}
	}

	handle_path /api/* {
		reverse_proxy api:4000 {
			# SSE (/api/realtime/stream): entrega imediata, sem buffering.
			flush_interval -1
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# Storage para o NAVEGADOR (URLs assinadas de visualização/download — D-061).
# STORAGE_PUBLIC_ENDPOINT=https://arquivos.example.com na API. O Host original é
# preservado (a assinatura SigV4 depende dele); sem acesso anônimo no SeaweedFS.
arquivos.example.com {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control "private, no-store"
		Cross-Origin-Resource-Policy same-site
		Content-Security-Policy "default-src 'none'; object-src 'none'; frame-ancestors https://receita.example.com; sandbox"
	}
	log {
		output file /var/log/caddy/receita-files.log
		format filter {
			# Assinaturas e credenciais temporárias nunca vão para o log de acesso.
			request>uri query delete *
		}
	}
	reverse_proxy seaweedfs:8333 {
		header_up Host {host}
	}
}
